# Use ONE endpoint: Laravel OR standalone hosting.
AFIKA_WEBHOOK_URL=https://your-domain.example/webhooks/whatsapp
# Same value as WHATSAPP_WEBHOOK_SECRET in Laravel, or secret in standalone config.
AFIKA_WEBHOOK_SECRET=
AFIKA_WHATSAPP_NUMBER=6282221992911
# Absolute path on VPS; keep this folder between deployments/restarts.
AFIKA_OUTBOX_DIR=/var/lib/afika/whatsapp-outbox
